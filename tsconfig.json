{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "skipLibCheck": true, "noEmit": true, "isolatedModules": true,
    "allowImportingTsExtensions": true, "useDefineForClassFields": true
  },
  "include": ["src"]
}
